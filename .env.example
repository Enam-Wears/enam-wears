# The storefront preview runs without environment variables.

# Required later when PostgreSQL is connected.
DATABASE_URL=""

# Google Drive:
# API key works only for publicly available Drive folders/files.
GOOGLE_DRIVE_API_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# Required for secure/private production Drive syncing.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Used to protect the future internal Drive report endpoint.
CATALOG_SYNC_SECRET=""

